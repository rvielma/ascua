{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    // Dentro del repositorio, los paquetes son los de packages/, como en
    // vite.config.ts. Una aplicación de verdad los tendría en node_modules.
    "paths": {
      "ascua": ["../../packages/runtime/src/index.ts"],
      "ascua/servidor": ["../../packages/runtime/src/servidor.ts"],
      "ascua-router": ["../../packages/router/src/index.ts"],
      "ascua-testing": ["../../packages/testing/src/index.ts"]
    }
  },
  "include": ["src", "test"]
}
