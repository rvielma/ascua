{
  "name": "ascua",
  "version": "0.5.0",
  "description": "Runtime reactivo de Ascua: signals, effects y operaciones directas de DOM. Sin Virtual DOM.",
  "keywords": [
    "reactividad",
    "signals",
    "dom",
    "ui",
    "sin-virtual-dom",
    "ascua"
  ],
  "homepage": "https://ascua.gitweave.run",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "files": [
    "dist",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "size": "node ../../scripts/measure-runtime.mjs",
    "prepublishOnly": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "terser": "^5.51.2"
  }
}
