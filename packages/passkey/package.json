{
  "name": "ascua-passkey",
  "version": "0.1.1",
  "description": "Passkeys (WebAuthn) sin dependencias: la ceremonia del navegador y la verificación en el servidor con Web Crypto.",
  "keywords": [
    "passkey",
    "webauthn",
    "fido2",
    "auth",
    "ascua"
  ],
  "homepage": "https://ascua.gitweave.run",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./server": {
      "types": "./server.d.ts",
      "default": "./server.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "server.js",
    "server.d.ts",
    "base64url.js",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run"
  },
  "devDependencies": {
    "happy-dom": "^20.14.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
