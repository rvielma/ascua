{
  "name": "vite-plugin-ascua",
  "version": "0.5.0",
  "description": "Plugin de Vite que compila las plantillas de Ascua con el compilador en WebAssembly.",
  "keywords": [
    "vite",
    "plugin",
    "ascua",
    "compilador",
    "wasm"
  ],
  "homepage": "https://ascua.gitweave.run",
  "license": "MIT OR Apache-2.0",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./site": {
      "types": "./sitio.d.ts",
      "default": "./sitio-comun.js"
    }
  },
  "files": [
    "index.js",
    "sitio.js",
    "sitio-comun.js",
    "sitio.d.ts",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "scripts": {
    "test": "vitest run"
  },
  "devDependencies": {
    "happy-dom": "^20.14.5",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "ascua-compilador": "0.4.0"
  },
  "peerDependencies": {
    "vite": ">=6",
    "ascua": ">=0.4.0"
  }
}
